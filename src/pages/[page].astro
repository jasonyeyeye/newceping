---
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { page: 'about' } },
    { params: { page: 'contact' } },
    { params: { page: 'privacy' } },
    { params: { page: 'terms' } },
    { params: { page: 'disclosure' } },
  ];
}

interface Props {
  page: string;
}

const { page } = Astro.params;

// Page content as markdown strings
