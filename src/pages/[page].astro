};

const currentPage = pages[page!];

if (!currentPage) {
  return Astro.redirect('/404');
}

// Remove the stray return Astro.redirect that causes export issues
const pageData = currentPage;

// Simple markdown to HTML converter
function renderMarkdown(content: string): string {
  return content
    .split('\n\n')
    .map(block => {
      if (block.startsWith('## ')) return `<h2 class="text-2xl font-bold text-white mt-10 mb-4">${block.slice(3)}</h2>`;
      if (block.startsWith('### ')) return `<h3 class="text-xl font-bold text-white mt-8 mb-3">${block.slice(4)}</h3>`;
      if (block.startsWith('**') && block.endsWith('**')) return `<h4 class="text-lg font-semibold text-white mt-6 mb-2">${block.replace(/\*\*/g, '')}</h4>`;
      if (block.startsWith('- ') || block.startsWith('* ')) {
        const items = block.split('\n').map(l => `<li class="ml-4 mb-1 text-gray-300">${l.replace(/^[\-\*]\s/, '')}</li>`).join('');
        return `<ul class="list-disc list-inside text-gray-300 mb-4 space-y-1">${items}</ul>`;
      }
      if (block.match(/^\d+\./)) {
        const items = block.split('\n').map(l => `<li class="ml-4 mb-1 text-gray-300">${l.replace(/^\d+\.\s/, '')}</li>`).join('');
        return `<ol class="list-decimal list-inside text-gray-300 mb-4 space-y-1">${items}</ol>`;
      }
      // Bold, italic, links
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
      block = block.replace(/\*(.+?)\*/g, '<em class="text-gray-300">$1</em>');
      block = block.replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" class="text-[var(--color-primary)] hover:underline">$1</a>');
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
      if (block.trim()) return `<p class="text-gray-300 mb-4 leading-relaxed">${block}</p>`;
      return '';
    })
    .join('');
}
---

<BaseLayout title={currentPage.title} description={currentPage.description}>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <article class="bg-[var(--color-surface)] rounded-2xl p-8 md:p-12 border border-white/10">
      <div class="prose prose-invert max-w-none" set:html={renderMarkdown(currentPage.content)} />
    </article>
  </section>
</BaseLayout>