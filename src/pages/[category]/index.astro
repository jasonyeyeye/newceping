---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categoryData, articles } from '../category-data';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(categoryData).map(cat => ({
    params: { category: cat },
    props: {
      cat: categoryData[cat as keyof typeof categoryData],
      articles: articles[cat as keyof typeof articles] || [],
    },
  }));
}

const cat = Astro.props.cat;
const categoryArticles = Astro.props.articles;
---

<BaseLayout title={`${cat.name} Reviews`} description={cat.description}>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">{cat.name}</h1>
      <p class="text-gray-400">{cat.description}</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categoryArticles.map(article => (
        <ArticleCard {...article} />
      ))}
    </div>
  </section>
</BaseLayout>