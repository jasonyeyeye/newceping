---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const apiBase = 'https://adult-toy-review-api.wangzczg-3e8.workers.dev';
  
  let articles: any[] = [];
  let categories: any[] = [];
  
  try {
    const [artsRes, catsRes] = await Promise.all([
      fetch(`${apiBase}/api/articles?status=published`),
      fetch(`${apiBase}/api/categories`),
    ]);
    if (artsRes.ok) articles = await artsRes.json();
    if (catsRes.ok) categories = await catsRes.json();
  } catch (e) {}

  const allPaths: any[] = [];

  for (const article of articles) {
    let catSlug = article.categorySlug || 'vibrators';
    let catName = article.category || 'Article';
    
    const cat = categories.find((c: any) => c.id === article.categoryId);
    if (cat) {
      catSlug = cat.slug;
      catName = cat.name;
    }

    allPaths.push({
      params: { category: catSlug, slug: article.slug },
      props: { article, category: { slug: catSlug, name: catName } },
    });
  }

  return allPaths;
}

const { article, category } = Astro.props;

// Raw content string for reading time and TOC generation
const rawContent = article.content || '';

// Render markdown to HTML (simplified renderer for the slot)
function renderMarkdown(content: string): string {
  if (!content) return '';
  
  return content
    .split('\n\n')
    .map(block => {
      if (block.startsWith('## ')) return `<h2 class="text-2xl font-bold text-white mt-8 mb-4">${block.slice(3)}</h2>`;
      if (block.startsWith('### ')) return `<h3 class="text-xl font-bold text-white mt-6 mb-3">${block.slice(4)}</h3>`;
      if (block.startsWith('# ')) return `<h1 class="text-3xl font-bold text-white mb-6">${block.slice(2)}</h1>`;
      if (block.includes('\n- ')) {
        const items = block.split('\n').filter(l => l.startsWith('- ')).map(l => `<li class="ml-4 mb-2">${l.slice(2)}</li>`).join('');
        return `<ul class="list-disc list-inside text-gray-300 mb-4 space-y-1">${items}</ul>`;
      }
      block = block.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
      block = block.replace(/\*(.+?)\*/g, '<em>$1</em>');
      block = block.replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2" class="text-[var(--color-primary)] hover:underline">$1</a>');
      if (block.trim()) return `<p class="text-gray-300 mb-4 leading-relaxed">${block}</p>`;
      return '';
    })
    .join('');
}

const date = article.publishedAt 
  ? new Date(article.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';

const htmlContent = renderMarkdown(article.content || '');

// Build affiliate links for ArticleLayout
const affiliateLinks = (article.affiliate?.links || []).map((link: any) => ({
  platform: link.platform,
  url: link.url,
  anchorText: `Buy on ${link.platform}`,
}));
---

<ArticleLayout
  title={article.title}
  description={article.excerpt || article.title}
  category={category.name}
  categorySlug={category.slug}
  featuredImage={article.featuredImage}
  publishedAt={article.publishedAt}
  author={article.author || 'The Review Team'}
  content={rawContent}
  affiliateLinks={affiliateLinks}
>
  <div class="prose prose-invert max-w-none">
    <Fragment set:html={htmlContent} />
  </div>
</ArticleLayout>