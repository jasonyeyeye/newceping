---
import BaseLayout from '../layouts/BaseLayout.astro';

const query = Astro.url.searchParams.get('q') || '';
---

<BaseLayout title={`Search${query ? ` — ${query}` : ''}`} description={`Search results for "${query}" on AdultToyReview`}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-white mb-8">Search</h1>
    
    <form method="GET" action="/search" class="mb-8">
      <div class="flex gap-3">
        <input 
          type="search" 
          name="q" 
          value={query}
          placeholder="Search articles..." 
          class="flex-1 px-4 py-3 bg-[var(--color-surface)] border border-white/10 rounded-lg text-white focus:border-[var(--color-primary)] focus:outline-none"
          autofocus
        />
        <button type="submit" class="px-6 py-3 bg-[var(--color-primary)] hover:bg-[var(--color-primary)]/80 text-white font-medium rounded-lg transition-colors">
          Search
        </button>
      </div>
    </form>
    
    <div id="search-results">
      <p class="text-gray-500">Loading...</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ query }}>
  const resultsEl = document.getElementById('search-results');
  const apiBase = 'https://adult-toy-review-api.wangzczg-3e8.workers.dev';

  async function performSearch() {
    if (!query.trim()) {
      resultsEl.innerHTML = '<p class="text-gray-500">Enter a search term to find articles.</p>';
      return;
    }

    try {
      const [catsRes, artsRes] = await Promise.all([
        fetch(`${apiBase}/api/categories`).then(r => r.ok ? r.json() : []),
        fetch(`${apiBase}/api/articles?status=published`).then(r => r.ok ? r.json() : []),
      ]);

      const q = query.toLowerCase();
      const results = artsRes.filter(a => {
        return a.title?.toLowerCase().includes(q) || 
               a.excerpt?.toLowerCase().includes(q) ||
               (a.content && typeof a.content === 'string' && a.content.toLowerCase().includes(q));
      });

      if (results.length === 0) {
        resultsEl.innerHTML = `<p class="text-gray-500">No results found for "${query}". Try a different search term.</p>`;
        return;
      }

      const catMap = {};
      catsRes.forEach(c => catMap[c.id] = c);

      let html = `<p class="text-sm text-gray-400 mb-6">${results.length} result${results.length !== 1 ? 's' : ''} found</p>`;
      html += '<div class="space-y-4">';

      for (const a of results) {
        const cat = a.categoryId ? catMap[a.categoryId] : null;
        const catName = cat?.name || '';
        const catSlug = cat?.slug || '';

        html += `<a href="/${catSlug}/${a.slug}" class="block bg-[var(--color-surface)] rounded-xl p-6 border border-white/10 hover:border-[var(--color-primary)] transition-all">
          <div class="flex items-center gap-2 mb-2">
            ${catName ? `<span class="text-xs font-medium text-[var(--color-primary)] uppercase tracking-wider">${catName}</span>` : ''}
          </div>
          <h3 class="text-lg font-semibold text-white mb-2 hover:text-[var(--color-primary)]">${a.title}</h3>
          ${a.excerpt ? `<p class="text-sm text-gray-400 line-clamp-2">${a.excerpt}</p>` : ''}
        </a>`;
      }

      html += '</div>';
      resultsEl.innerHTML = html;
    } catch (e) {
      resultsEl.innerHTML = '<p class="text-gray-500">Failed to load results. Please try again.</p>';
    }
  }

  performSearch();
</script>
