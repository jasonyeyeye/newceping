---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  category: string;
  categorySlug: string;
  featuredImage?: string;
  publishedAt?: string;
  author?: string;
  content?: string; // raw markdown content for reading time
  affiliateLinks?: Array<{
    platform: string;
    url: string;
    anchorText: string;
  }>;
}

const {
  title,
  description,
  category,
  categorySlug,
  featuredImage,
  publishedAt,
  author = 'The Review Team',
  content = '',
  affiliateLinks = []
} = Astro.props;

// Calculate reading time: ceil(wordCount / 200)
function calcReadingTime(md: string): number {
  const words = md.trim().split(/\s+/).filter(Boolean).length;
  return Math.ceil(words / 200);
}

const readingTime = calcReadingTime(content);

const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
---

<BaseLayout title={title} description={description} ogImage={featuredImage}>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-[var(--color-primary)] z-[60]" style="width: 0%;"></div>

  <!-- Article JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "image": featuredImage || undefined,
    "datePublished": publishedAt,
    "dateModified": new Date().toISOString(),
    "author": { "@type": "Person", "name": author },
    "publisher": {
      "@type": "Organization",
      "name": "AdultToyReview",
      "logo": { "@type": "ImageObject", "url": "https://master.adult-toy-review.pages.dev/favicon.svg" }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": new URL(Astro.url.pathname, "https://master.adult-toy-review.pages.dev").href
    }
  })} />
  <!-- BreadcrumbList JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://master.adult-toy-review.pages.dev" },
      { "@type": "ListItem", "position": 2, "name": category, "item": `https://master.adult-toy-review.pages.dev/${categorySlug}` },
      { "@type": "ListItem", "position": 3, "name": title }
    ]
  })} />

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div id="toc-container" class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-8">
      <div id="article-main">
        <!-- Article Header -->
        <header class="mb-10">
          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-gray-400 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="text-gray-600">/</span>
            <a href={`/${categorySlug}`} class="hover:text-white transition-colors">{category}</a>
            <span class="text-gray-600">/</span>
            <span class="text-gray-300 truncate max-w-[200px]">{title}</span>
          </nav>
          <div class="flex items-center gap-2 mb-4">
            <a href={`/${categorySlug}`} class="text-xs font-medium text-[var(--color-primary)] uppercase tracking-wider hover:underline">
              {category}
            </a>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">{title}</h1>
          <div class="flex items-center gap-4 text-sm text-gray-500">
            {formattedDate && <span>{formattedDate}</span>}
            <span>By {author}</span>
            <span class="text-[var(--color-primary)]">·</span>
            <span>{readingTime} min read</span>
          </div>
        </header>

        {featuredImage && (
          <div class="aspect-video rounded-xl overflow-hidden mb-10">
            <img
              src={featuredImage}
              alt={title}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <!-- Article Body (slot for content) -->
        <div id="article-content" class="prose prose-invert max-w-none">
          <slot />
        </div>

        <!-- Affiliate CTA -->
        {affiliateLinks.length > 0 && (
          <div class="mt-12 bg-[var(--color-surface)] rounded-xl p-6 border border-[var(--color-primary)]/30">
            <h3 class="font-semibold text-white mb-3">Where to Buy</h3>
            <div class="flex flex-wrap gap-3">
              {affiliateLinks.map(link => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener sponsored"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary)]/80 text-white text-sm font-medium rounded-lg transition-colors"
                >
                  <span>Buy on {link.platform}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ))}
            </div>
            <p class="text-xs text-gray-500 mt-3">
              * As an affiliate, we may earn a commission from qualifying purchases at no additional cost to you.
            </p>
          </div>
        )}

        <!-- Article Footer -->
        <footer class="mt-12 pt-8 border-t border-white/10">
          <div class="flex items-center justify-between">
            <a href={`/${categorySlug}`} class="text-sm text-gray-400 hover:text-white">
              ← Back to {category}
            </a>
          </div>
        </footer>
      </div>
      <!-- TOC sidebar injected by client-side script -->
    </div>
  </div>

  <!-- Back to Top Button -->
  <button id="back-to-top" aria-label="Back to top" class="fixed bottom-6 right-6 w-10 h-10 bg-[var(--color-primary)] rounded-full flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 hover:bg-[var(--color-primary)]/80 z-50">
    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
    </svg>
  </button>

  <!-- Client-side scripts -->
  <script>
    // TOC generation + heading IDs + reading progress + back-to-top + active TOC
    (function() {
      // Reading Progress Bar
      const progressBar = document.getElementById('reading-progress');
      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) progressBar.style.width = progress + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // Back to Top Button
      const backToTopBtn = document.getElementById('back-to-top');
      function updateBackToTop() {
        if (window.scrollY > 300) {
          backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn?.classList.add('opacity-100');
        } else {
          backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
          backToTopBtn?.classList.remove('opacity-100');
        }
      }
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      backToTopBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // TOC: extract headings from article content and build sidebar
      const articleContent = document.getElementById('article-content');
      const tocContainer = document.getElementById('toc-container');

      if (articleContent && tocContainer) {
        const headingEls = articleContent.querySelectorAll('h2, h3');
        
        if (headingEls.length >= 2) {
          // Add IDs to headings
          headingEls.forEach(el => {
            const text = el.textContent || '';
            const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            el.id = id;
          });

          // Build TOC HTML
          const tocItems = Array.from(headingEls).map(h => {
            const text = h.textContent || '';
            const id = h.id;
            const level = h.tagName === 'H2' ? 2 : 3;
            return { level, text, id };
          });

          const tocHtml = `
            <nav id="toc-sidebar" class="toc-sidebar" aria-label="Table of Contents">
              <h4 class="toc-title">Table of Contents</h4>
              <ul class="toc-list">
                ${tocItems.map(item => `
                  <li class="toc-item level-${item.level}">
                    <a href="#${item.id}" class="toc-link">${item.text}</a>
                  </li>
                `).join('')}
              </ul>
            </nav>
          `;

          // Create aside element
          const aside = document.createElement('aside');
          aside.innerHTML = tocHtml;
          tocContainer.appendChild(aside);

          // TOC active state via IntersectionObserver
          const tocLinks = aside.querySelectorAll('.toc-link');
          const headingElsWithId = articleContent.querySelectorAll('h2[id], h3[id]');

          if (tocLinks.length > 0 && headingElsWithId.length > 0) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  tocLinks.forEach(link => link.classList.remove('active'));
                  const activeLink = aside.querySelector(`.toc-link[href="#${entry.target.id}"]`);
                  if (activeLink) activeLink.classList.add('active');
                }
              });
            }, { rootMargin: '-20% 0px -60% 0px' });

            headingElsWithId.forEach(h => observer.observe(h));
          }
        }
      }
    })();
  </script>
</BaseLayout>