---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-surface)] border-t border-white/10 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-bold text-[var(--color-primary)] mb-4">AdultToyReview</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Independent, honest reviews of adult toys and products. We test what we recommend — no sponsored content, no hidden agendas.
        </p>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Categories</h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li><a href="/vibrators" class="hover:text-[var(--color-primary)]">Vibrators</a></li>
          <li><a href="/smart-toys" class="hover:text-[var(--color-primary)]">Smart Toys</a></li>
          <li><a href="/for-couples" class="hover:text-[var(--color-primary)]">For Couples</a></li>
          <li><a href="/wellness" class="hover:text-[var(--color-primary)]">Wellness</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Legal</h4>
        <p class="text-xs text-gray-500 leading-relaxed">
          * We may earn a commission from qualifying purchases. As an affiliate, we may receive compensation from qualifying purchases made through links on this site at no additional cost to you. Our content is not influenced by advertisers or affiliate partnerships.
        </p>
      </div>
    </div>
    <div class="border-t border-white/10 mt-8 pt-8 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} AdultToyReview. All rights reserved. 18+ only.</p>
    </div>
  </div>
</footer>