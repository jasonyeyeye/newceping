---
// Default nav items as fallback (matches current hardcoded nav)
const defaultNavItems = [
  { label: 'Home', href: '/', type: 'category' },
  { label: 'Vibrators', href: '/vibrators', type: 'category' },
  { label: 'Smart Toys', href: '/smart-toys', type: 'category' },
  { label: 'For Couples', href: '/for-couples', type: 'category' },
  { label: 'Wellness', href: '/wellness', type: 'category' },
];

const apiBase = 'https://adult-toy-review-api.wangzczg-3e8.workers.dev';
---

<header class="bg-[var(--color-surface)] border-b border-white/10 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold text-[var(--color-primary)]">
      AdultToy<span class="text-white">Review</span>
    </a>
    <nav id="desktop-nav" class="hidden md:flex items-center gap-6">
      <!-- Nav items loaded via JS from API -->
      <span class="text-sm text-gray-400">Loading...</span>
    </nav>
    <button id="mobile-menu-btn" class="md:hidden text-gray-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4">
    <div id="mobile-nav-items">
      <!-- Mobile nav items loaded via JS -->
    </div>
  </div>
</header>

<script define:vars={{ defaultNavItems, apiBase }}>
  async function loadNavigation() {
    try {
      const res = await fetch(`${apiBase}/api/navigation`);
      const navItems = await res.json();
      
      if (!navItems || navItems.length === 0) {
        renderNav(defaultNavItems);
        return;
      }
      
      renderNav(navItems);
    } catch (e) {
      console.error('Failed to load navigation:', e);
      renderNav(defaultNavItems);
    }
  }

  function renderNav(items) {
    const desktopNav = document.getElementById('desktop-nav');
    const mobileNav = document.getElementById('mobile-nav-items');
    
    if (!desktopNav || !mobileNav) return;

    let desktopHtml = '';
    let mobileHtml = '';

    items.forEach(item => {
      const html = `
        <a href="${item.url || item.href || '/'}" 
           class="text-sm text-gray-300 hover:text-[var(--color-primary)] transition-colors"
           ${item.type === 'external' ? 'target="_blank" rel="noopener"' : ''}>
          ${item.label}
        </a>
      `;
      desktopHtml += html;
      mobileHtml += `<a href="${item.url || item.href || '/'}" class="block py-2 text-sm text-gray-300 hover:text-[var(--color-primary)]">${item.label}</a>`;
    });

    desktopNav.innerHTML = desktopHtml;
    mobileNav.innerHTML = mobileHtml;
  }

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  // Load navigation on page load
  loadNavigation();
</script>
