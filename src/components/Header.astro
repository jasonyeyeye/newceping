---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Vibrators', href: '/vibrators' },
  { label: 'Smart Toys', href: '/smart-toys' },
  { label: 'For Couples', href: '/for-couples' },
  { label: 'Wellness', href: '/wellness' },
];
---

<header class="bg-[var(--color-surface)] border-b border-white/10 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold text-[var(--color-primary)]">
      AdultToy<span class="text-white">Review</span>
    </a>
    <nav class="hidden md:flex items-center gap-6">
      {navItems.map(item => (
        <a
          href={item.href}
          class="text-sm text-gray-300 hover:text-[var(--color-primary)] transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button id="mobile-menu-btn" class="md:hidden text-gray-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4">
    {navItems.map(item => (
      <a href={item.href} class="block py-2 text-sm text-gray-300 hover:text-[var(--color-primary)]">
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>